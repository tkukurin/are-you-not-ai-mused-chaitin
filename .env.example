# Copy to .env if you need to override defaults. Both commands work with no .env at all:
#   uv run demo   # replay-only Street Feast — deterministic, no model download
#   uv run app    # live app — Muse Glimmer via llama-server (downloads the model on first run)

# Dolt (native sql-server, data in .dolt-data/)
DOLT_ROOT_PASSWORD=dolt-demo-password
# DOLT_PORT=3306
# DOLT_DATABASE=malleable

# Ports
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# LLAMA_PORT=8080

# Muse Glimmer — the only live model (local llama.cpp, OpenAI-compatible)
# LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_MODEL=muse-glimmer-30b
# LOCAL_API_KEY=
# LLAMA_CTX=32768

# Optional: DoltHub remote for `POST /api/dolt/push` (org/repo)
# DOLTHUB_REMOTE=
